<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>EdenChat | AI Character Chat</title>
<link rel="manifest" href="data:application/json,%7B%22name%22%3A%22EdenChat%20Clone%22%2C%22short_name%22%3A%22EdenChat%22%2C%22start_url%22%3A%22.%22%2C%22display%22%3A%22standalone%22%2C%22background_color%22%3A%22%230a0a0a%22%2C%22theme_color%22%3A%22%230a0a0a%22%7D">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{--bg:#0a0a0a;--card:#141414;--border:#222;--fg:#e8e8e8;--muted:#888;--accent:#e8b4b8;--safe-badge:#4ade80}
[data-theme=light]{--bg:#f5f5f5;--card:#fff;--border:#e0e0e0;--fg:#1a1a1a;--muted:#666;--accent:#c97b80;--safe-badge:#22c55e}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:var(--bg);color:var(--fg);min-height:100vh;display:flex;flex-direction:column;-webkit-font-smoothing:antialiased;-webkit-tap-highlight-color:transparent}
a{color:inherit;text-decoration:none}
button{cursor:pointer;border:none;font-family:inherit;background:none;color:inherit;font-size:inherit}
input,textarea{font-family:inherit}

/* Header */
header{position:sticky;top:0;z-index:100;background:rgba(10,10,10,0.9);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--border)}
.header-inner{max-width:1200px;margin:auto;padding:0 16px;height:56px;display:flex;align-items:center;justify-content:space-between}
.logo{display:flex;align-items:center;gap:8px;font-weight:700;font-size:18px}
.logo-icon{width:32px;height:32px;border-radius:8px;background:var(--accent);color:#000;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:bold}
.nav-btns{display:flex;align-items:center;gap:8px}
.nav-btns button{padding:6px 14px;border-radius:20px;font-size:13px;background:var(--card);color:var(--fg);border:1px solid var(--border)}
.icon-btn{width:36px;height:36px;border-radius:50%;background:var(--card);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:16px}

/* Hero */
.hero{text-align:center;padding:40px 16px 24px}
.hero h1{font-size:clamp(22px,5vw,32px);font-weight:800;margin-bottom:8px;background:linear-gradient(135deg,var(--accent),#c084fc,#f472b6);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.hero p{color:var(--muted);font-size:14px;margin-bottom:16px}
.unlimited-banner{display:inline-flex;align-items:center;gap:8px;padding:8px 20px;border-radius:30px;font-size:13px;font-weight:600;background:rgba(74,222,128,0.12);color:#4ade80;border:1px solid rgba(74,222,128,0.25)}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.6}} .pulse{animation:pulse 2s infinite}

/* Categories */
.cat-bar{max-width:1200px;margin:0 auto 16px;padding:0 16px;display:flex;gap:6px;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none}
.cat-bar::-webkit-scrollbar{display:none}
.cat-btn{padding:6px 14px;border-radius:20px;font-size:12px;font-weight:600;white-space:nowrap;background:var(--card);color:var(--muted);border:1px solid var(--border);transition:all .15s;-webkit-user-select:none;user-select:none}
.cat-btn.active{background:var(--accent);color:#000;border-color:var(--accent)}

/* Sort bar */
.sort-bar{max-width:1200px;margin:0 auto 16px;padding:0 16px;display:flex;gap:6px;flex-wrap:wrap}
.sort-btn{padding:4px 12px;border-radius:14px;font-size:11px;background:transparent;color:var(--muted);border:1px solid var(--border);transition:all .15s;-webkit-user-select:none;user-select:none}
.sort-btn.active{background:var(--accent);color:#000;border-color:var(--accent)}

/* Grid */
.main-content{flex:1;max-width:1200px;margin:auto;width:100%;padding:0 16px 24px}
.section-title{font-size:16px;font-weight:700;margin-bottom:12px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px}

/* Card */
.card{background:var(--card);border:1px solid var(--border);border-radius:14px;overflow:hidden;transition:transform .15s;cursor:pointer;-webkit-tap-highlight-color:transparent}
.card:active{transform:scale(.98)}
.card-cover{height:160px;display:flex;align-items:center;justify-content:center;font-size:48px;font-weight:800;color:rgba(255,255,255,.3);position:relative}
.card-body{padding:12px}
.card-name{font-size:14px;font-weight:700;margin-bottom:4px;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.card-desc{font-size:12px;color:var(--muted);margin-bottom:8px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.card-meta{display:flex;justify-content:space-between;align-items:center;font-size:11px;color:var(--muted)}
.card-badges{display:flex;gap:4px}
.safe-badge{font-size:9px;font-weight:800;padding:2px 6px;border-radius:4px;background:var(--safe-badge);color:#000}
.official-badge{font-size:9px;font-weight:800;padding:2px 6px;border-radius:4px;background:var(--accent);color:#000}
.card-author{font-size:11px;color:var(--muted)}

/* Trending */
.trending{margin-top:24px}
.trending-list{display:flex;gap:10px;overflow-x:auto;-webkit-overflow-scrolling:touch;padding-bottom:8px;scrollbar-width:none}
.trending-list::-webkit-scrollbar{display:none}
.trending-item{flex-shrink:0;width:150px;background:var(--card);border:1px solid var(--border);border-radius:12px;overflow:hidden;cursor:pointer;-webkit-tap-highlight-color:transparent}
.trending-item:active{transform:scale(.96)}
.trending-cover{height:90px;display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:800;color:rgba(255,255,255,.3)}
.trending-body{padding:8px}
.trending-name{font-size:12px;font-weight:600;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.trending-views{font-size:10px;color:var(--muted);margin-top:2px}

/* Footer */
footer{border-top:1px solid var(--border);padding:24px 16px;text-align:center}
.footer-links{display:flex;justify-content:center;gap:16px;margin-bottom:12px;flex-wrap:wrap}
.footer-links a{font-size:12px;color:var(--muted}
.footer-copy{font-size:11px;color:var(--muted);line-height:1.6}

/* Chat Overlay */
.chat-overlay{position:fixed;top:0;left:0;right:0;bottom:0;z-index:200;background:var(--bg);display:flex;flex-direction:column;transform:translateX(100%);transition:transform .3s ease}
.chat-overlay.open{transform:translateX(0)}
.chat-header{display:flex;align-items:center;gap:12px;padding:12px 16px;border-bottom:1px solid var(--border);background:var(--card);flex-shrink:0}
.chat-back{width:36px;height:36px;border-radius:50%;background:var(--border);display:flex;align-items:center;justify-content:center;font-size:18px;cursor:pointer;-webkit-tap-highlight-color:transparent}
.chat-title{flex:1;min-width:0}
.chat-title h3{font-size:15px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chat-title p{font-size:11px;color:var(--muted)}
.chat-clear{padding:6px 14px;border-radius:14px;font-size:12px;background:var(--border);cursor:pointer;-webkit-tap-highlight-color:transparent}
.chat-messages{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:12px;-webkit-overflow-scrolling:touch}
.chat-welcome{text-align:center;padding:40px 16px;color:var(--muted)}
.chat-welcome h3{font-size:18px;font-weight:700;color:var(--fg);margin-bottom:8px}
.msg-user{align-self:flex-end;max-width:80%;padding:10px 14px;border-radius:18px 18px 4px 18px;background:var(--accent);color:#000;font-size:14px;line-height:1.5;word-break:break-word}
.msg-ai{align-self:flex-start;max-width:80%;padding:10px 14px;border-radius:18px 18px 18px 4px;background:var(--card);border:1px solid var(--border);font-size:14px;line-height:1.5;word-break:break-word}
.typing{align-self:flex-start;display:flex;gap:4px;padding:10px 14px;background:var(--card);border:1px solid var(--border);border-radius:18px 18px 18px 4px}
.typing span{width:8px;height:8px;border-radius:50%;background:var(--muted);animation:bounce 1.4s infinite both}
.typing span:nth-child(2){animation-delay:.2s}.typing span:nth-child(3){animation-delay:.4s}
@keyframes bounce{0%,80%,100%{transform:scale(.6)}40%{transform:scale(1)}}
.token-bar{padding:8px 16px;text-align:center;font-size:11px;font-weight:600;background:rgba(74,222,128,0.08);color:#4ade80;border-top:1px solid rgba(74,222,128,.15);flex-shrink:0}
.chat-input-area{display:flex;gap:8px;padding:12px 16px;border-top:1px solid var(--border);background:var(--card);flex-shrink:0}
.chat-input{flex:1;padding:10px 16px;border-radius:24px;border:1px solid var(--border);background:var(--bg);color:var(--fg);font-size:14px;outline:none}
.chat-send{width:44px;height:44px;border-radius:50%;background:var(--accent);color:#000;font-size:18px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;cursor:pointer;-webkit-tap-highlight-color:transparent}
.chat-send:disabled{opacity:.4}

/* Search Overlay */
.search-overlay{position:fixed;top:0;left:0;right:0;bottom:0;z-index:200;background:var(--bg);display:flex;flex-direction:column;transform:translateY(-100%);transition:transform .3s ease}
.search-overlay.open{transform:translateY(0)}
.search-header{display:flex;align-items:center;gap:12px;padding:12px 16px;border-bottom:1px solid var(--border)}
.search-input{flex:1;padding:10px 16px;border-radius:24px;border:1px solid var(--border);background:var(--card);color:var(--fg);font-size:14px;outline:none}
.search-results{flex:1;overflow-y:auto;padding:16px}

/* Load more */
.load-more{text-align:center;padding:16px}
.load-more button{padding:10px 32px;border-radius:24px;font-size:13px;font-weight:600;background:var(--accent);color:#000;cursor:pointer;-webkit-tap-highlight-color:transparent}

/* Responsive */
@media(max-width:640px){
  .grid{grid-template-columns:1fr}
  .hero{padding:28px 12px 16px}
  .cat-bar{padding:0 12px}
  .main-content{padding:0 12px 16px}
}
</style>
</head>
