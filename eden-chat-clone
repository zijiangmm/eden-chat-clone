(function(){
// ========== DATA ==========
var CATS = ['All Works','New','Ranking','Following','Bookmarks',
  'Simulation','Romance','Fantasy/Sci-Fi','Drama','Wuxia/Historical',
  'Horror/Mystery','Action','Comedy/Slice of Life','Sports/School','BL','GL','Other'];

var WORKS = [
  {id:'w1',name:'EN GARDE - The Sword Maiden Never Smiles at Me',desc:'Her blade is cold, but is her heart too?',category:'Fantasy/Sci-Fi',author:'FantasyMaster',chapters:35,likes:150,views:30000,safe:true,official:false,tags:['fantasy','action','romance'],g:'#667eea,#764ba2'},
  {id:'w2',name:'The Perfect Prince Is Actually a Girl?',desc:'Your Highness... wait, what?!',category:'Romance',author:'GenderBenderFan',chapters:28,likes:135,views:28000,safe:true,official:false,tags:['romance','comedy'],g:'#f093fb,#f5576c'},
  {id:'w3',name:'Picking Up a High School Girl on a Rainy Day',desc:'A rainy encounter that changes everything.',category:'Romance',author:'DorangmuOfficial',chapters:5,likes:5,views:25800,safe:true,official:true,tags:['romance','drama'],g:'#4facfe,#00f2fe'},
  {id:'w4',name:'One Day I Became a Villainess',desc:'I opened my eyes and realized... I am the villainess!',category:'Drama',author:'VillainessLover',chapters:50,likes:120,views:25000,safe:true,official:false,tags:['drama','isekai'],g:'#fa709a,#fee140'},
  {id:'w5',name:'Delboa Magic High School',desc:'Where magic and destiny intertwine.',category:'Fantasy/Sci-Fi',author:'Deolbo',chapters:48,likes:48,views:22500,safe:true,official:false,tags:['magic','school'],g:'#a18cd1,#fbc2eb'},
  {id:'w6',name:'Love as Vast as the Universe Embracing the Moon',desc:'Under the moonlight, our destinies intertwined.',category:'Romance',author:'CosmicRomance',chapters:22,likes:110,views:22000,safe:true,official:false,tags:['romance','cosmic'],g:'#ffecd2,#fcb69f'},
  {id:'w7',name:'My Master Is Already Dead',desc:"Master's last words echo in your mind...",category:'Wuxia/Historical',author:'WuxiaMaster',chapters:45,likes:98,views:19000,safe:true,official:false,tags:['wuxia','revenge'],g:'#89f7fe,#66a6ff'},
  {id:'w8',name:'Dungeon Explorers',desc:'The dungeon gate creaks open...',category:'Action',author:'DungeonMaster',chapters:40,likes:95,views:18000,safe:true,official:false,tags:['dungeon','rpg'],g:'#f6d365,#fda085'},
  {id:'w9',name:'Last Loop (Safety)',desc:'Loop count: 147. This time will be different.',category:'Fantasy/Sci-Fi',author:'LoopBreaker',chapters:17,likes:72,views:16000,safe:true,official:false,tags:['timeloop','psychological'],g:'#a1c4fd,#c2e9fb'},
  {id:'w10',name:'House of Tomorrow',desc:'The door to tomorrow opens before you...',category:'Fantasy/Sci-Fi',author:'SciFiWriter',chapters:30,likes:89,views:15000,safe:true,official:false,tags:['scifi','future'],g:'#d299c2,#fef9d7'},
  {id:'w11',name:'I Got a Fake Confession from the Class Beauty',desc:'She confessed... but was it real?',category:'Romance',author:'RomanceKing',chapters:60,likes:200,views:45000,safe:true,official:false,tags:['romance','school'],g:'#f5576c,#f093fb'},
  {id:'w12',name:'Midnight Stroll Through the Haunted Mansion',desc:'Every creak tells a story of the departed.',category:'Horror/Mystery',author:'GhostWriter',chapters:25,likes:88,views:14000,safe:true,official:false,tags:['horror','ghost'],g:'#2c3e50,#34495e'},
  {id:'w13',name:"The Demon King's Secretary",desc:'Managing the demon king schedule is harder than conquering the world.',category:'Comedy/Slice of Life',author:'ComedyQueen',chapters:33,likes:105,views:17000,safe:true,official:false,tags:['comedy','office'],g:'#f7971e,#ffd200'},
  {id:'w14',name:'Blade & Blossom Academy',desc:'Where swordsmanship meets elegance.',category:'Sports/School',author:'SchoolLifePro',chapters:42,likes:92,views:15500,safe:true,official:false,tags:['school','sports'],g:'#11998e,#38ef7d'},
  {id:'w15',name:'Whispers in the Dark',desc:'Two souls bound by fate, torn by society.',category:'BL',author:'BLMaster',chapters:38,likes:180,views:35000,safe:true,official:false,tags:['BL','romance'],g:'#8E2DE2,#4A00E0'},
  {id:'w16',name:'Garden of Moonlit Petals',desc:'In this garden, love blooms differently.',category:'GL',author:'GLWriter',chapters:27,likes:145,views:28000,safe:true,official:false,tags:['GL','romance'],g:'#ee9ca7,#ffdde1'},
  {id:'w17',name:'The Last Stand of Humanity',desc:'When all hope fades, heroes rise.',category:'Action',author:'ActionHero',chapters:55,likes:165,views:32000,safe:true,official:false,tags:['action','apocalypse'],g:'#eb3349,#f45c43'},
  {id:'w18',name:'Coffee Shop at the Edge of the World',desc:'A warm cup, a quiet corner, infinite stories.',category:'Slice of Life',author:'CozyWriter',chapters:20,likes:78,views:12000,safe:true,official:false,tags:['sliceoflife','healing'],g:'#d4fc79,#96e6a1'}
];

var R_ROMANTIC = [
  "*blushes softly* Y-you really feel that way? My heart is beating so fast right now...",
  "*looks away shyly* I... I have never had anyone say something like that to me before...",
  "*gently takes your hand* Stay with me... just a little longer.",
  "*whispers* Every moment with you feels like a dream I never want to wake from...",
  "*smiles warmly* You always know how to make my heart skip a beat..."
];
var R_DRAMATIC = [
  "*eyes darken* You have no idea what I have been through... what I have sacrificed...",
  "*clenches fist* This world took everything from me. But I won let it take you too.",
  "*voice trembling* I thought I was alone... until you came into my life.",
  "*turns away* Some stories are better left untold. But for you... I will make an exception."
];
var R_ACTION = [
  "*draws weapon* Stand behind me. I will handle this.",
  "*grins fiercely* You think that is enough to stop us? Let us show them what we are made of!",
  "*breathing heavily* That was close... but we made it. Together.",
  "*eyes burning with determination* I will not lose. Not now. Not ever."
];
var R_DEFAULT = [
  "*smiles warmly* That is interesting! Tell me more about yourself~",
  "*nods thoughtfully* I see... You have such fascinating ideas!",
  "*leans in curiously* Oh? Now you have caught my attention~",
  "*laughs softly* You are quite different from others, are not you? I like that~",
  "*tilts head* Hmm, let me think about that for a moment...",
  "*grins playfully* Oh really? Do go on, I am all ears~"
];

// ========== STATE ==========
var currentCat = 'All Works';
var currentSort = 'new';
var displayedCount = 6;
var currentWorkId = null;
var imageBlur = false;
var bookmarks = [];

try {
  var t = localStorage.getItem('eden-theme');
  if(t) document.documentElement.setAttribute('data-theme',t);
  var b = localStorage.getItem('eden-bookmarks');
  if(b) bookmarks = JSON.parse(b);
} catch(e){}

// ========== UTILS ==========
function fmt(n){return n>=1000?(n/1000).toFixed(0)+'K':''+n;}
function esc(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}

function getFiltered(){
  var list = WORKS.slice();
  if(currentCat && currentCat !== 'All Works' && !['New','Ranking','Following','Bookmarks'].indexOf(currentCat)+1)
    list = list.filter(function(w){return w.category === currentCat;});
  if(currentCat === 'Bookmarks') list = list.filter(function(w){return bookmarks.indexOf(w.id)!==-1;});
  if(currentSort === 'all') return list;
  return list.sort(function(a,b){return b.views - a.views;});
}

function getWorkById(id){for(var i=0;i<WORKS.length;i++)if(WORKS[i].id===id)return WORKS[i];return null;}

// ========== RENDER CATEGORIES ==========
function renderCats(){
  var html = '';
  for(var i=0;i<CATS.length;i++){
    var c = CATS[i];
    html += '<button class="cat-btn'+(c===currentCat?' active':'')+'" data-cat="'+esc(c)+'">'+esc(c)+'</button>';
  }
  document.getElementById('catBar').innerHTML = html;
  // bind events
  var btns = document.getElementById('catBar').querySelectorAll('.cat-btn');
  for(var j=0;j<btns.length;j++){
    (function(btn){
      btn.addEventListener('click',function(){setCat(btn.getAttribute('data-cat'));},false);
    })(btns[j]);
  }
}

function setCat(cat){
  currentCat = cat;
  displayedCount = 6;
  renderCats();renderWorks();
}

// ========== SORT ==========
function renderSorts(){
  var sorts = [['new','New releases'],['realtime','realtime'],['daily','daily'],['monthly','monthly'],['all','all']];
  var html = '';
  for(var i=0;i<sorts.length;i++){
    var s = sorts[i];
    html += '<button class="sort-btn'+(s[0]===currentSort?' active':'')+'" data-sort="'+s[0]+'">'+s[1]+'</button>';
  }
  document.getElementById('sortBar').innerHTML = html;
  var btns = document.getElementById('sortBar').querySelectorAll('.sort-btn');
  for(var j=0;j<btns.length;j++){
    (function(btn){
      btn.addEventListener('click',function(){setSort(btn.getAttribute('data-sort'));},false);
    })(btns[j]);
  }
}

function setSort(s){currentSort=s;renderSorts();renderWorks();}

// ========== RENDER WORKS ==========
function renderWorks(){
  var filtered = getFiltered();
  var show = filtered.slice(0, displayedCount);
  document.getElementById('sectionTitle').textContent = esc(currentCat)+' ('+filtered.length+')';
  var html = '';
  for(var i=0;i<show.length;i++){
    var w = show[i];
    html += '<div class="card" data-wid="'+esc(w.id)+'">';
    html += '<div class="card-cover" style="background:linear-gradient(135deg,'+esc(w.g)+')">'+esc(w.name.charAt(0))+'</div>';
    html += '<div class="card-body">';
    html += '<div style="display:flex;gap:4px;margin-bottom:6px;flex-wrap:wrap">';
    if(w.safe) html += '<span class="safe-badge">SAFE</span>';
    if(w.official) html += '<span class="official-badge">Official</span>';
    html += '</div>';
    html += '<div class="card-name">'+esc(w.name)+'</div>';
    html += '<div class="card-desc">'+esc(w.desc)+'</div>';
    html += '<div class="card-meta">';
    html += '<span>'+w.chapters+' ch | '+w.likes+' likes | '+fmt(w.views)+'</span>';
    html += '<span class="card-author">'+esc(w.author)+'</span>';
    html += '</div></div></div>';
  }
  document.getElementById('worksGrid').innerHTML = html;
  // bind click
  var cards = document.getElementById('worksGrid').querySelectorAll('.card');
  for(var k=0;k<cards.length;k++){
    (function(card){
      card.addEventListener('click',function(){openChat(card.getAttribute('data-wid'));},false);
    })(cards[k]);
  }
}

function loadMore(){displayedCount+=3;renderWorks();}

// ========== TRENDING ==========
function renderTrending(){
  var top = WORKS.slice().sort(function(a,b){return b.views-a.views;}).slice(0,6);
  var html = '';
  for(var i=0;i<top.length;i++){
    var w = top[i];
    html += '<div class="trending-item" data-wid="'+esc(w.id)+'">';
    html += '<div class="trending-cover" style="background:linear-gradient(135deg,'+esc(w.g)+')">'+esc(w.name.charAt(0))+'</div>';
    html += '<div class="trending-body">';
    html += '<div class="trending-name">'+esc(w.name)+'</div>';
    html += '<div class="trending-views">'+fmt(w.views)+' views</div>';
    html += '</div></div>';
  }
  document.getElementById('trendingList').innerHTML = html;
  var items = document.getElementById('trendingList').querySelectorAll('.trending-item');
  for(var j=0;j<items.length;j++){
    (function(item){
      item.addEventListener('click',function(){openChat(item.getAttribute('data-wid'));},false);
    })(items[j]);
  }
}

// ========== CHAT ==========
function openChat(workId){
  var w = getWorkById(workId);
  if(!w)return;
  currentWorkId = workId;
  document.getElementById('chatWorkName').textContent = w.name;
  document.getElementById('chatAuthor').textContent = 'by '+w.author;
  document.getElementById('chatMessages').innerHTML =
    '<div class="chat-welcome"><h3>* Start chatting!</h3>'+
    '<p>Start chatting with <strong>'+esc(w.name)+'</strong></p>'+
    '<p style="margin-top:8px;font-size:12px">Unlimited tokens * No restrictions</p></div>';
  document.getElementById('chatOverlay').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function closeChat(){
  document.getElementById('chatOverlay').classList.remove('open');
  document.body.style.overflow = '';
  currentWorkId = null;
}

function clearChat(){
  if(!currentWorkId)return;
  var w = getWorkById(currentWorkId);
  document.getElementById('chatMessages').innerHTML =
    '<div class="chat-welcome"><h3>* Chat cleared</h3><p>Start a fresh conversation~</p></div>';
}

function sendMsg(){
  var input = document.getElementById('chatInput');
  var text = input.value.trim();
  if(!text || !currentWorkId)return;
  var msgs = document.getElementById('chatMessages');
  var welcome = msgs.querySelector('.chat-welcome');
  if(welcome)welcome.remove();

  // user msg
  var d = document.createElement('div');
  d.className='msg-user';d.textContent=text;msgs.appendChild(d);

  input.value='';
  msgs.scrollTop = msgs.scrollHeight;

  // typing
  var t = document.createElement('div');
  t.className='typing';t.id='typingInd';
  t.innerHTML='<span></span><span></span><span></span>';msgs.appendChild(t);
  msgs.scrollTop = msgs.scrollHeight;

  // ai response
  var w = getWorkById(currentWorkId);
  setTimeout(function(){
    var ti = document.getElementById('typingInd');
    if(ti)ti.remove();
    var pool = R_DEFAULT;
    var cat = w ? w.category : '';
    if(cat.indexOf('Romance')!==-1||cat.indexOf('BL')!==-1||cat.indexOf('GL')!==-1) pool = R_ROMANTIC;
    else if(cat.indexOf('Drama')!==-1||cat.indexOf('Horror')!==-1) pool = R_DRAMATIC;
    else if(cat.indexOf('Action')!==-1||cat.indexOf('Wuxia')!==-1) pool = R_ACTION;

    var reply = pool[Math.floor(Math.random()*pool.length)];
    var ad = document.createElement('div');
    ad.className='msg-ai';ad.textContent=reply;msgs.appendChild(d);
    ad.textContent=reply;msgs.appendChild(ad);
    msgs.scrollTop = msgs.scrollHeight;
  }, 1000 + Math.random()*1500);
}

document.getElementById('chatInput').addEventListener('keydown',function(e){
  if(e.key==='Enter')sendMsg();
});

// ========== SEARCH ==========
function toggleSearch(){
  var o = document.getElementById('searchOverlay');
  o.classList.toggle('open');
  if(o.classList.contains('open')){document.getElementById('searchInput').focus();document.body.style.overflow='hidden';}
  else document.body.style.overflow='';
}

function doSearch(){
  var q = document.getElementById('searchInput').value.toLowerCase().trim();
  var container = document.getElementById('searchResults');
  if(!q){container.innerHTML='<p style="color:var(--muted);text-align:center;padding:20px">Type to search...</p>';return;}
  var results = [];
  for(var i=0;i<WORKS.length;i++){
    var w = WORKS[i];
    if(w.name.toLowerCase().indexOf(q)!==-1||w.author.toLowerCase().indexOf(q)!==-1||
       w.category.toLowerCase().indexOf(q)!==-1||w.desc.toLowerCase().indexOf(q)!==-1)
      results.push(w);
  }
  if(results.length===0){container.innerHTML='<p style="color:var(--muted);text-align:center;padding:40px">No results found</p>';return;}
  var html = '';
  for(var j=0;j<results.length;j++){
    var w = results[j];
    html += '<div class="card" style="margin-bottom:10px" data-swid="'+esc(w.id)+'">';
    html += '<div class="card-cover" style="height:100px;background:linear-gradient(135deg,'+esc(w.g)+')">'+esc(w.name.charAt(0))+'</div>';
    html += '<div class="card-body"><div class="card-name">'+esc(w.name)+'</div>';
    html += '<div class="card-desc">'+esc(w.desc)+'</div>';
    html += '<div class="card-meta"><span>'+fmt(w.views)+' views</span><span>'+esc(w.author)+'</span></div>';
    html += '</div></div>';
  }
  container.innerHTML = html;
  var cards = container.querySelectorAll('.card');
  for(var k=0;k<cards.length;k++){
    (function(card){
      card.addEventListener('click',function(){openChat(card.getAttribute('data-swid'));toggleSearch();},false);
    })(cards[k]);
  }
}

// ========== THEME / BLUR ==========
function toggleTheme(){
  var html = document.documentElement;
  var next = html.getAttribute('data-theme')==='dark'?'light':'dark';
  html.setAttribute('data-theme',next);
  try{localStorage.setItem('eden-theme',next);}catch(e){}
}

function toggleBlur(){
  imageBlur = !imageBlur;
  var sel = document.querySelectorAll('.card-cover,.trending-cover');
  for(var i=0;i<sel.length;i++)
    sel[i].style.filter = imageBlur ? 'blur(20px)' : '';
}

// ========== INIT ==========
renderCats();
renderSorts();
renderWorks();
renderTrending();

})();
</script>
